/* =================================
   MAZE HUNTER - CSS
   ================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
}

body {
    background:
        radial-gradient(
            circle at center,
            #202020 0%,
            #090909 55%,
            #000000 100%
        );

    color: #ffffff;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    min-height: 100vh;

    overflow: hidden;
}

/* =================================
   TÍTULO
   ================================= */

h1 {
    margin: 0 0 12px;

    color: #ffe600;

    font-size: 32px;
    font-weight: 900;

    letter-spacing: 4px;

    text-align: center;

    text-shadow:
        0 0 5px #ffcc00,
        0 0 15px #ff9900,
        0 0 30px #ff6600;
}

/* =================================
   PAINEL DE INFORMAÇÕES
   ================================= */

#info {
    width: 480px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 10px 14px;

    margin-bottom: 10px;

    background:
        linear-gradient(
            180deg,
            #242424,
            #101010
        );

    border: 2px solid #333;

    border-radius: 8px;

    box-shadow:
        0 4px 15px rgba(0, 0, 0, .7),
        inset 0 1px 0 rgba(255,255,255,.08);

    font-size: 14px;
    font-weight: bold;
}

/* =================================
   PONTUAÇÃO
   ================================= */

#score {
    color: #ffe600;

    text-shadow:
        0 0 6px rgba(255, 230, 0, .7);
}

/* =================================
   VIDAS
   ================================= */

#lives {
    color: #ff4444;

    text-shadow:
        0 0 6px rgba(255, 0, 0, .7);
}

/* =================================
   NÍVEL
   ================================= */

#level {
    color: #55ccff;

    text-shadow:
        0 0 6px rgba(0, 180, 255, .7);
}

/* =================================
   CANVAS DO JOGO
   ================================= */

#game {
    display: block;

    width: 480px;
    height: 360px;

    background: #000000;

    border: 5px solid #171717;

    border-radius: 6px;

    outline: 2px solid #343434;

    image-rendering: pixelated;

    box-shadow:
        0 0 0 4px #050505,
        0 0 25px rgba(0, 0, 0, .9),
        0 0 50px rgba(20, 30, 100, .15);
}

/* =================================
   EFEITO AO PASSAR O MOUSE
   ================================= */

#game:hover {
    outline-color: #505050;

    box-shadow:
        0 0 0 4px #050505,
        0 0 30px rgba(0, 60, 255, .25);
}

/* =================================
   MENSAGEM
   ================================= */

#message {
    margin-top: 12px;

    color: #aaa;

    font-size: 14px;

    text-align: center;

    text-shadow:
        1px 1px 2px #000;
}

/* =================================
   BOTÃO
   ================================= */

button {
    margin-top: 12px;

    padding: 10px 28px;

    color: #111;

    background:
        linear-gradient(
            180deg,
            #fff23b,
            #ffc400
        );

    border: 2px solid #8c6d00;

    border-radius: 6px;

    font-size: 14px;
    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 4px 0 #765900,
        0 6px 15px rgba(0,0,0,.5);

    transition:
        transform .1s,
        filter .15s;
}

button:hover {
    filter: brightness(1.15);

    transform: translateY(-1px);

    box-shadow:
        0 5px 0 #765900,
        0 8px 18px rgba(0,0,0,.6);
}

button:active {
    transform: translateY(3px);

    box-shadow:
        0 2px 0 #765900;
}

/* =================================
   RESPONSIVIDADE
   ================================= */

@media (max-width: 600px) {

    body {
        overflow-y: auto;

        justify-content: flex-start;

        padding-top: 20px;
    }

    h1 {
        font-size: 24px;

        letter-spacing: 2px;
    }

    #info {
        width: 95vw;

        font-size: 11px;

        padding: 8px;
    }

    #game {
        width: 95vw;
        height: auto;

        aspect-ratio: 4 / 3;
    }

    #message {
        font-size: 12px;
    }

    button {
        padding: 9px 22px;
    }
}

/* =================================
   ANIMAÇÃO DO TÍTULO
   ================================= */

@keyframes titleGlow {

    0% {
        text-shadow:
            0 0 5px #ffcc00,
            0 0 15px #ff9900;
    }

    50% {
        text-shadow:
            0 0 8px #ffff00,
            0 0 25px #ff9900,
            0 0 40px #ff5500;
    }

    100% {
        text-shadow:
            0 0 5px #ffcc00,
            0 0 15px #ff9900;
    }
}

h1 {
    animation: titleGlow 2s infinite alternate;
}
