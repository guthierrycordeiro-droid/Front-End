
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maze Hunter</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    background: #050505;
    color: white;
    font-family: Arial, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

h1 {
    margin: 0 0 10px;
    color: #ffe600;
    text-shadow: 0 0 10px #ffb300;
}

#info {
    width: 480px;
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-weight: bold;
}

#game {
    border: 4px solid #222;
    background: #000;
    image-rendering: pixelated;
    box-shadow: 0 0 25px #111;
}

#message {
    margin-top: 10px;
    color: #aaa;
}

button {
    margin-top: 12px;
    padding: 10px 25px;
    background: #ffd900;
    border: none;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #fff000;
}
</style>
</head>

<body>

<h1>MAZE HUNTER</h1>

<div id="info">
    <span>🏆 Pontos: <b id="score">0</b></span>
    <span>❤️ Vidas: <b id="lives">3</b></span>
    <span>⭐ Nível: <b id="level">1</b></span>
</div>

<canvas id="game" width="480" height="480"></canvas>

<div id="message">
    Use as setas ou WASD para jogar
</div>

<button onclick="restartGame()">Novo jogo</button>

<script>

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const TILE = 24;

const map = [
"####################",
"#..................#",
"#.####.#####.####..#",
"#..................#",
"#.####.#####.####..#",
"#......#...#.......#",
"######.#...#.#######",
"#......#...#.......#",
"#.####.#...#.####..#",
"#..................#",
"#.####.#####.####..#",
"#..................#",
"#.####.#####.####..#",
"#..................#",
"####################"
];

const ROWS = map.length;
const COLS = map[0].length;

canvas.width = COLS * TILE;
canvas.height = ROWS * TILE;

let score = 0;
let lives = 3;
let level = 1;

let gameRunning = true;

const player = {
    x: 1,
    y: 1,
    dx: 0,
    dy: 0,
    nextDx: 0,
    nextDy: 0
};

let dots = [];

const ghosts = [
    {
        x: 9,
        y: 7,
        color: "#ff3333",
        dx: 1,
        dy: 0
    },
    {
        x: 10,
        y: 7,
        color: "#ff69d9",
        dx: -1,
        dy: 0
    },
    {
        x: 9,
        y: 8,
        color: "#33ffff",
        dx: 0,
        dy: -1
    },
    {
        x: 10,
        y: 8,
        color: "#ff9f22",
        dx: 0,
        dy: 1
    }
];

function resetDots() {

    dots = [];

    for (let y = 0; y < ROWS; y++) {

        for (let x = 0; x < COLS; x++) {

            if (map[y][x] === ".") {

                dots.push({
                    x,
                    y
                });

            }
        }
    }
}

function isWall(x, y) {

    if (
        x < 0 ||
        y < 0 ||
        x >= COLS ||
        y >= ROWS
    ) {
        return true;
    }

    return map[y][x] === "#";
}

function canMove(x, y, dx, dy) {

    return !isWall(
        x + dx,
        y + dy
    );
}

document.addEventListener("keydown", function(e) {

    const key = e.key.toLowerCase();

    if (
        key === "arrowup" ||
        key === "w"
    ) {
        player.nextDx = 0;
        player.nextDy = -1;
    }

    if (
        key === "arrowdown" ||
        key === "s"
    ) {
        player.nextDx = 0;
        player.nextDy = 1;
    }

    if (
        key === "arrowleft" ||
        key === "a"
    ) {
        player.nextDx = -1;
        player.nextDy = 0;
    }

    if (
        key === "arrowright" ||
        key === "d"
    ) {
        player.nextDx = 1;
        player.nextDy = 0;
    }

});

function movePlayer() {

    if (
        canMove(
            player.x,
            player.y,
            player.nextDx,
            player.nextDy
        )
    ) {

        player.dx = player.nextDx;
        player.dy = player.nextDy;

    }

    if (
        canMove(
            player.x,
            player.y,
            player.dx,
            player.dy
        )
    ) {

        player.x += player.dx;
        player.y += player.dy;

    }

    collectDot();

    checkGhostCollision();
}

function collectDot() {

    for (let i = dots.length - 1; i >= 0; i--) {

        if (
            dots[i].x === player.x &&
            dots[i].y === player.y
        ) {

            dots.splice(i, 1);

            score += 10;

            if (dots.length === 0) {

                level++;

                resetDots();

                player.x = 1;
                player.y = 1;

                player.dx = 0;
                player.dy = 0;

            }
        }
    }
}

function moveGhosts() {

    ghosts.forEach(ghost => {

        let possible = [];

        const directions = [
            { dx: 1, dy: 0 },
            { dx: -1, dy: 0 },
            { dx: 0, dy: 1 },
            { dx: 0, dy: -1 }
        ];

        directions.forEach(dir => {

            if (
                !isWall(
                    ghost.x + dir.dx,
                    ghost.y + dir.dy
                )
            ) {

                possible.push(dir);

            }
        });

        // Evita voltar imediatamente
        let valid = possible.filter(dir =>
            !(dir.dx === -ghost.dx &&
              dir.dy === -ghost.dy)
        );

        if (valid.length === 0) {
            valid = possible;
        }

        // Às vezes persegue o jogador
        if (Math.random() < 0.45) {

            valid.sort((a, b) => {

                const da =
                    Math.abs(
                        ghost.x + a.dx - player.x
                    ) +
                    Math.abs(
                        ghost.y + a.dy - player.y
                    );

                const db =
                    Math.abs(
                        ghost.x + b.dx - player.x
                    ) +
                    Math.abs(
                        ghost.y + b.dy - player.y
                    );

                return da - db;
            });
        } else {

            valid.sort(() => Math.random() - 0.5);

        }

        if (valid.length > 0) {

            ghost.dx = valid[0].dx;
            ghost.dy = valid[0].dy;

            ghost.x += ghost.dx;
            ghost.y += ghost.dy;

        }

    });
}

function checkGhostCollision() {

    for (const ghost of ghosts) {

        if (
            ghost.x === player.x &&
            ghost.y === player.y
        ) {

            loseLife();

            break;
        }
    }
}

function loseLife() {

    lives--;

    if (lives <= 0) {

        gameRunning = false;

        document.getElementById("message")
            .textContent =
            "GAME OVER! Clique em Novo jogo.";

        return;
    }

    player.x = 1;
    player.y = 1;

    player.dx = 0;
    player.dy = 0;

    ghosts[0].x = 9;
    ghosts[0].y = 7;

    ghosts[1].x = 10;
    ghosts[1].y = 7;

    ghosts[2].x = 9;
    ghosts[2].y = 8;

    ghosts[3].x = 10;
    ghosts[3].y = 8;
}

function drawMap() {

    for (let y = 0; y < ROWS; y++) {

        for (let x = 0; x < COLS; x++) {

            const px = x * TILE;
            const py = y * TILE;

            if (map[y][x] === "#") {

                ctx.fillStyle = "#111b80";
                ctx.fillRect(
                    px,
                    py,
                    TILE,
                    TILE
                );

                ctx.strokeStyle = "#3045e8";
                ctx.strokeRect(
                    px + 2,
                    py + 2,
                    TILE - 4,
                    TILE - 4
                );

            } else {

                ctx.fillStyle = "#000";
                ctx.fillRect(
                    px,
                    py,
                    TILE,
                    TILE
                );
            }
        }
    }
}

function drawDots() {

    ctx.fillStyle = "#fff";

    dots.forEach(dot => {

        ctx.beginPath();

        ctx.arc(
            dot.x * TILE + TILE / 2,
            dot.y * TILE + TILE / 2,
            3,
            0,
            Math.PI * 2
        );

        ctx.fill();
    });
}

function drawPlayer() {

    const px =
        player.x * TILE + TILE / 2;

    const py =
        player.y * TILE + TILE / 2;

    ctx.fillStyle = "#ffe600";

    ctx.beginPath();

    let angle = 0;

    if (player.dx === -1) {
        angle = Math.PI;
    }

    if (player.dy === -1) {
        angle = -Math.PI / 2;
    }

    if (player.dy === 1) {
        angle = Math.PI / 2;
    }

    const mouth = 0.35;

    ctx.moveTo(px, py);

    ctx.arc(
        px,
        py,
        9,
        angle + mouth,
        angle + Math.PI * 2 - mouth
    );

    ctx.closePath();

    ctx.fill();
}

function drawGhost(ghost) {

    const px =
        ghost.x * TILE + TILE / 2;

    const py =
        ghost.y * TILE + TILE / 2;

    ctx.fillStyle = ghost.color;

    ctx.beginPath();

    ctx.arc(
        px,
        py - 2,
        9,
        Math.PI,
        0
    );

    ctx.lineTo(px + 9, py + 9);

    ctx.lineTo(px + 4, py + 6);

    ctx.lineTo(px, py + 10);

    ctx.lineTo(px - 4, py + 6);

    ctx.lineTo(px - 9, py + 9);

    ctx.closePath();

    ctx.fill();

    // olhos
    ctx.fillStyle = "white";

    ctx.beginPath();
    ctx.arc(px - 4, py - 2, 3, 0, Math.PI * 2);
    ctx.arc(px + 4, py - 2, 3, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = "#111";

    ctx.beginPath();
    ctx.arc(px - 4, py - 2, 1.5, 0, Math.PI * 2);
    ctx.arc(px + 4, py - 2, 1.5, 0, Math.PI * 2);
    ctx.fill();
}

function draw() {

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    drawMap();
    drawDots();

    ghosts.forEach(drawGhost);

    drawPlayer();

    document.getElementById("score")
        .textContent = score;

    document.getElementById("lives")
        .textContent = lives;

    document.getElementById("level")
        .textContent = level;
}

let lastTime = 0;

function gameLoop(time) {

    if (!gameRunning) {

        draw();

        return;
    }

    if (time - lastTime > 150) {

        movePlayer();
        moveGhosts();

        lastTime = time;
    }

    draw();

    requestAnimationFrame(gameLoop);
}

function restartGame() {

    score = 0;
    lives = 3;
    level = 1;

    gameRunning = true;

    player.x = 1;
    player.y = 1;

    player.dx = 0;
    player.dy = 0;

    player.nextDx = 0;
    player.nextDy = 0;

    resetDots();

    ghosts[0].x = 9;
    ghosts[0].y = 7;

    ghosts[1].x = 10;
    ghosts[1].y = 7;

    ghosts[2].x = 9;
    ghosts[2].y = 8;

    ghosts[3].x = 10;
    ghosts[3].y = 8;

    document.getElementById("message")
        .textContent =
        "Use as setas ou WASD para jogar";

    lastTime = performance.now();

    requestAnimationFrame(gameLoop);
}

resetDots();
requestAnimationFrame(gameLoop);

</script>

</body>
</html>

